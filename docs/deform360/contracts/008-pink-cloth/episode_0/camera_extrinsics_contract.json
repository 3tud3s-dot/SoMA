{
  "schema_version": 1,
  "task": "T8: camera extrinsics conversion only",
  "status": "PASS",
  "created_on": "2026-09-25",
  "dataset": "008-pink-cloth/episode_0",
  "authority": "This repository contract defines T8 extrinsics. Camera selection remains defined by the human-confirmed camera_config_2cam.json and camera_config_3cam.json.",
  "downstream": "T9 reads configurations.A/B.c2w in the exact camera_ids order. No resized intrinsics or calibrate.pkl are produced.",
  "convention": {
    "qvec_order": [
      "w",
      "x",
      "y",
      "z"
    ],
    "quaternion_algebra": "Hamilton",
    "qvec_semantics": "world-to-camera rotation",
    "tvec_semantics": "world origin expressed in camera coordinates; not world-space camera center",
    "point_convention": "column vectors; X_camera = R @ X_world + t",
    "camera_axes": {
      "x": "right",
      "y": "down",
      "z": "forward"
    },
    "w2c": "[[R,t],[0,0,0,1]]",
    "c2w": "[[R.T,-R.T@t],[0,0,0,1]]",
    "rotation_computation": "q_normalized=qvec/norm(qvec); R=SoMA.mmgs.utils.colmap_utils.qvec2rotmat(q_normalized)",
    "normalization_note": "Only removes published quaternion unit-norm rounding error of at most 5.1e-13; original qvec/tvec and calibration file remain unchanged.",
    "camera_center_world": "-R.T @ t",
    "forward_world": "R.T @ [0,0,1]",
    "matrix_storage": "JSON nested rows; float64 computation; each c2w [4,4]",
    "world_frame_and_length_scale": "Preserve the published metric calibration and splat_113.xyz world frame and length scale; no recentering, reorientation, rescaling or axis flip.",
    "axis_flip_applied": false,
    "soma_interface": "extract_extrinsics(c2w) returns R_soma=R.T and T_soma=t; getWorld2View2(R_soma,T_soma) reconstructs w2c in float32. R_soma is not the rotation block of w2c."
  },
  "convention_evidence": {
    "published_header": "# cam_id width height fx fy cx cy k1 k2 p1 p2 cam_name qvecw qvecx qvecy qvecz tvecx tvecy tvecz",
    "reference": "https://colmap.github.io/format.html#images-txt",
    "interpretation_basis": "Header explicitly identifies wxyz. The COLMAP qvec/tvec w2c interpretation is corroborated by actual frame 113 Gaussian positive depth, image projections and foreground mask correspondence. No trial axis flips.",
    "source_limitation": "Current Deform360 calibration.py:1-19 describes extrinsics.npy c2w, a different format; it does not establish this legacy text exporter convention. No exporter for this text was found. Interpretation is supported jointly by the header, COLMAP convention and actual geometric projection.",
    "layout_limitation": "T7 layout used the same convention; agreement is a regression check, not independent proof of the convention.",
    "projection_limitation": "Gaussian center projections only, not visibility or render-quality tests. Foreground hit fractions are not used to change camera selection."
  },
